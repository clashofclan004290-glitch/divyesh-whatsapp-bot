# ──────────────────────────────────────────────────────────────────────────────
# Divyesh WhatsApp Bot — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# Get from: https://developers.facebook.com > Your App > WhatsApp > API Setup
WHATSAPP_TOKEN=your_whatsapp_permanent_token_here

# Your WhatsApp Business Phone Number ID (from Meta Developer Console)
PHONE_NUMBER_ID=your_phone_number_id_here

# A secret string YOU choose — used to verify webhook during Meta setup
VERIFY_TOKEN=divyesh_bot_secret_2024

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com > Your Project > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Server ────────────────────────────────────────────────────────────────────
# Render sets PORT automatically; keep this for local dev
PORT=3000
